# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ============================================================================
# BACKEND & API CONFIGURATION
# ============================================================================
# The Python API and database live behind VITE_API_BASE_URL. These variables are
# SAFE to expose in the browser bundle: they contain only public endpoints.
# NEVER put secrets in VITE_-prefixed variables, because Vite inlines them into
# client-side JavaScript where anyone can read them.
#
# Explicitly forbidden in frontend variables (see AUTH_STRATEGY.md):
#   - Supabase service_role key
#   - Database password / connection string
#   - Python API private keys or JWT signing secrets
#
# Authentication uses backend-managed sessions over HttpOnly cookies, so no
# token ever needs to be stored in a Vite variable or in localStorage.
# ============================================================================

# VITE_API_BASE_URL: Base URL of the Python REST API.
# Local:   http://localhost:8000/api/v1
# Staging: https://api-staging.dentcare.example.com/api/v1
# Prod:    https://api.dentcare.example.com/api/v1
# Defaults to http://localhost:8000/api/v1 when unset (local development).
VITE_API_BASE_URL="http://localhost:8000/api/v1"

# VITE_APP_URL: Public URL of this frontend. Sent to the backend as the allowed
# CORS origin for the session cookie, so it must match VITE_API_BASE_URL's
# expected allowlist exactly per environment.
VITE_APP_URL="http://localhost:3000"