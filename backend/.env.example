# Backend environment variables (server-only). Never commit real values.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=<anon-public>
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret>
DATABASE_URL=postgres://postgres.<project>:<password>@<host>:5432/postgres?pgbouncer=true
SESSION_SECRET=<rotate-me>
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
CORS_ORIGINS=https://app.dentcare.example.com
ENVIRONMENT=production
